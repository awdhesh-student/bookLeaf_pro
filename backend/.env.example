NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/bookleaf_support
MONGODB_DB_NAME=bookleaf_support

# JWT Secret: Generate a strong random string using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_long_random_secret_string_here_minimum_32_chars
JWT_EXPIRES_IN=1d
COOKIE_NAME=bookleaf_session

# Google Gemini API (Free tier - up to 15 requests per minute)
# Get your FREE API key from: https://aistudio.google.com/app/apikey
# No credit card required for free tier!
# Available models: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=700

LOG_LEVEL=info

# Seeding credentials (auto-generated if not provided)
# Only uncomment and modify if you want specific credentials:
# SEED_AUTHOR_PASSWORD=YourPassword123
# SEED_ADMIN_EMAIL=admin@yourdomain.com
# SEED_ADMIN_PASSWORD=AdminPassword123
